PGHOST=aws-1-eu-west-3.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.lboaendcihxzwkkjfgio
PGPASSWORD=
PGSSL=true
# Putanja je relativna u odnosu na direktorij backend.
PGSSLROOTCERT=certs/supabase-ca.crt

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generiraj: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Postavi samo prema stvarnom broju pouzdanih reverse proxy poslužitelja.
TRUST_PROXY_HOPS=0

# Kontrole upisa za prijave kandidata.
# Zadano isključeno; prije uključivanja provjeri ciljnu bazu i ovlasti.
APPLICATION_WRITES_ENABLED=false
APPLICATION_WRITES_CONFIRMED=false
# Samo uz zasebno odobrenje za upise u udaljenu bazu.
APPLICATION_WRITES_ALLOW_REMOTE=false

# Upravljanje casting oglasima, statusima i odabirom kandidata.
# Trenutačni backend dopušta te upise samo na lokalnoj bazi
# PGHOST=127.0.0.1, PGPORT=5432, PGDATABASE=castme_test.
# Postavljanje na true NE omogućuje upise u Supabase.
EMPLOYER_CASTING_WRITES_ENABLED=false
EMPLOYER_CASTING_WRITES_CONFIRMED=false
