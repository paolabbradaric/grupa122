digraph CastMeIfYouCan {
graph [rankdir=LR, overlap=false, splines=polyline, bgcolor=white];
node [shape=record, fontname=Arial, fontsize=10];
edge [color="#8394a6", arrowsize=.6];
"users" [label="{users|PK id\lUQ auth_id, email\lrole, deleted_at\l}"];
"candidate_profiles" [label="{candidate_profiles|PK id · FK user_id → users\lbio, experience\lweight_kg, eye_color, hair_color\l}"];
"organisations" [label="{organisations|PK id · FK owner_id → users\lUQ reg_num\l}"];
"projects" [label="{projects|PK id · FK org_id → organisations\ltitle, project_type\l}"];
"casting_calls" [label="{casting_calls|PK id · FK project_id → projects\lstatus, positions_count\lmax_applications, role_genre\l}"];
"applications" [label="{applications|PK id · FK candidate_id → candidate_profiles\lFK casting_call_id → casting_calls\lstatus, rejection_reason\l}"];
"audition_slots" [label="{audition_slots|PK id · FK casting_call_id → casting_calls\lcapacity, starts_at, ends_at\l}"];
"audition_bookings" [label="{audition_bookings|PK id · FK audition_slot_id → audition_slots\lFK application_id → applications\lstatus, attendance_status\l}"];
"notifications" [label="{notifications|PK id · FK user_id → users\lFK application_id, casting_call_id\lFK booking_id (svi opcionalni)\l}"];
"verification" [label="{verification|PK id · FK org_id → organisations\lFK reviewed_by → users (opc.)\l}"];
"casting_reports" [label="{casting_reports|PK id · FK casting_call_id (opc.)\lFK reporter_id, reviewed_by → users\l}"];
"app_private.moderation_events" [label="{app_private.moderation_events|PK id · FK actor_id → users\laction, entity_id\l}"];
"media_files" [label="{media_files|PK id · FK owner_user_id → users\lUQ (id, owner_user_id)\l}"];
"profile_media" [label="{profile_media|PK media_id · FK → media_files\lFK candidate_id → candidate_profiles\lFK org_id → organisations (uvjetno)\l}"];
"profile_storage_objects" [label="{profile_storage_objects|PK storage_key\lbez stranih ključeva\l}"];
"application_files" [label="{application_files|PK (application_id, media_file_id)\lFK → applications, media_files\l}"];
"skills" [label="{skills|PK id · UQ name\lcategory\l}"];
"candidate_skills" [label="{candidate_skills|PK (candidate_id, skill_id)\lFK → candidate_profiles, skills\l}"];
"casting_call_skills" [label="{casting_call_skills|PK (casting_call_id, skill_id)\lFK → casting_calls, skills\l}"];
"casting_call_status_history" [label="{casting_call_status_history|PK id · FK casting_call_id → casting_calls\lFK changed_by → users (opc.)\l}"];
"application_status_history" [label="{application_status_history|PK id · FK application_id → applications\lFK changed_by → users (opc.)\l}"];
"app_private.sessions" [label="{app_private.sessions|PK sid · JSON sess\lnema SQL FK prema users\l}"];
"app_private.moderation_file_cleanup" [label="{app_private.moderation_file_cleanup|PK storage_key\lbez stranih ključeva\l}"];
"app_private.application_submission_limits" [label="{app_private.application_submission_limits|PK/FK user_id → public.users\ltotal_hits, reset_at\l}"];
"candidate_profiles" -> "users" [label="user_id", fontsize=8];
"organisations" -> "users" [label="owner_id", fontsize=8];
"projects" -> "organisations" [label="org_id", fontsize=8];
"casting_calls" -> "projects" [label="project_id", fontsize=8];
"applications" -> "candidate_profiles" [label="candidate_id", fontsize=8];
"applications" -> "casting_calls" [label="casting_call_id", fontsize=8];
"audition_slots" -> "casting_calls" [label="casting_call_id", fontsize=8];
"audition_bookings" -> "audition_slots" [label="audition_slot_id", fontsize=8];
"audition_bookings" -> "applications" [label="application_id", fontsize=8];
"notifications" -> "users" [label="user_id", fontsize=8];
"notifications" -> "applications" [label="application_id", fontsize=8];
"notifications" -> "casting_calls" [label="casting_call_id", fontsize=8];
"notifications" -> "audition_bookings" [label="booking_id", fontsize=8];
"media_files" -> "users" [label="owner_user_id", fontsize=8];
"verification" -> "organisations" [label="org_id", fontsize=8];
"verification" -> "users" [label="reviewed_by", fontsize=8];
"candidate_skills" -> "candidate_profiles" [label="candidate_id", fontsize=8];
"candidate_skills" -> "skills" [label="skill_id", fontsize=8];
"casting_call_skills" -> "casting_calls" [label="casting_call_id", fontsize=8];
"casting_call_skills" -> "skills" [label="skill_id", fontsize=8];
"application_files" -> "applications" [label="application_id", fontsize=8];
"application_files" -> "media_files" [label="media_file_id", fontsize=8];
"casting_call_status_history" -> "casting_calls" [label="casting_call_id", fontsize=8];
"casting_call_status_history" -> "users" [label="changed_by", fontsize=8];
"application_status_history" -> "applications" [label="application_id", fontsize=8];
"application_status_history" -> "users" [label="changed_by", fontsize=8];
"profile_media" -> "media_files" [label="(media_id, owner_user_id)", fontsize=8];
"profile_media" -> "candidate_profiles" [label="(candidate_id, owner_user_id)", fontsize=8];
"profile_media" -> "organisations" [label="(org_id, owner_user_id)", fontsize=8];
"casting_reports" -> "casting_calls" [label="casting_call_id", fontsize=8];
"casting_reports" -> "users" [label="reporter_id", fontsize=8];
"casting_reports" -> "users" [label="reviewed_by", fontsize=8];
"app_private.moderation_events" -> "users" [label="actor_id", fontsize=8];
"app_private.application_submission_limits" -> "users" [label="user_id", fontsize=8];
}
